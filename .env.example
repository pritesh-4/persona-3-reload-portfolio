# Persona 3 Reload Developer Portfolio — Environment Variables Template
# Copy this file to .env.local for local overrides (never commit secrets)

# Base path for deployment:
# - Use './' for relative asset hosting (default, works on GitHub Pages subpaths)
# - Use '/' for root-level domain deployments (Vercel, Netlify, Custom Domain)
VITE_BASE_PATH=./

# Optional: GitHub Personal Access Token (fine-grained, read-only: public_repo, user:read)
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr for telemetry
# VITE_GITHUB_TOKEN=ghp_your_token_here
